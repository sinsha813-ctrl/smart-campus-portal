                            <div class="space-y-3">
                                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex justify-between items-center">
                                    <div>
                                        <h4 class="text-sm font-semibold text-gray-800">Semester Final Examination Timetable Released</h4>
                                        <p class="text-xs text-gray-500 mt-0.5">Check the Exam Schedule tab for complete dates and hall allotments.</p>
                                    </div>
                                    <span class="px-3 py-1 bg-indigo-100 text-brand-700 text-xs font-bold rounded-lg">New</span>
                                </div>
                                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex justify-between items-center">
                                    <div>
                                        <h4 class="text-sm font-semibold text-gray-800">Annual Tech Fest 'NexusHack 2026' Registrations Open</h4>
                                        <p class="text-xs text-gray-500 mt-0.5">Over $10,000 in prizes. Register under Program Schedule.</p>
                                    </div>
                                    <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-lg">Open</span>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 mb-4">Quick Student Links</h3>
                                <div class="space-y-3">
                                    <button onclick="switchTab('pyqs')" class="w-full py-2.5 px-4 bg-gray-50 hover:bg-gray-100 text-gray-700 text-sm font-medium rounded-xl border border-gray-200 text-left flex items-center justify-between">
                                        <span><i class="fa-solid fa-book-bookmark text-brand-600 mr-2"></i> Download PYQs</span>
                                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                                    </button>
                                    <button onclick="switchTab('exams')" class="w-full py-2.5 px-4 bg-gray-50 hover:bg-gray-100 text-gray-700 text-sm font-medium rounded-xl border border-gray-200 text-left flex items-center justify-between">
                                        <span><i class="fa-solid fa-file-lines text-brand-600 mr-2"></i> View Exam Timetable</span>
                                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                                    </button>
                                    <button onclick="switchTab('college')" class="w-full py-2.5 px-4 bg-gray-50 hover:bg-gray-100 text-gray-700 text-sm font-medium rounded-xl border border-gray-200 text-left flex items-center justify-between">
                                        <span><i class="fa-solid fa-building-columns text-brand-600 mr-2"></i> Faculty Directory</span>
                                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EXAM SCHEDULE TAB -->
                <div id="tab-exams" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900">Semester Examination Schedule</h3>
                                <p class="text-sm text-gray-500">Mid-term and End-semester timetable, hall allotments, and seating layouts.</p>
                            </div>
                            <button onclick="alert('Exam Hall Ticket downloaded successfully as PDF.')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-xl transition-colors">
                                <i class="fa-solid fa-download mr-1.5"></i> Download Hall Ticket
                            </button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50">
                                        <th class="p-4">Course Code</th>
                                        <th class="p-4">Subject Name</th>
                                        <th class="p-4">Date</th>
                                        <th class="p-4">Time</th>
                                        <th class="p-4">Exam Hall</th>
                                        <th class="p-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 text-sm">
                                    <tr>
                                        <td class="p-4 font-semibold text-gray-900">CS-401</td>
                                        <td class="p-4">Artificial Intelligence & Neural Nets</td>
