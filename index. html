                                        <td class="p-4 text-gray-600">10:00 AM - 01:00 PM</td>
                                        <td class="p-4 text-gray-600">Auditorium Hall A</td>
                                        <td class="p-4"><span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-lg">Upcoming</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-4 font-semibold text-gray-900">CS-402</td>
                                        <td class="p-4">Distributed Systems Architecture</td>
                                        <td class="p-4 text-gray-600">Nov 25, 2026</td>
                                        <td class="p-4 text-gray-600">02:00 PM - 05:00 PM</td>
                                        <td class="p-4 text-gray-600">Science Block 3B</td>
                                        <td class="p-4"><span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-lg">Upcoming</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-4 font-semibold text-gray-900">EC-305</td>
                                        <td class="p-4">Embedded IoT Microcontrollers</td>
                                        <td class="p-4 text-gray-600">Nov 28, 2026</td>
                                        <td class="p-4 text-gray-600">10:00 AM - 01:00 PM</td>
                                        <td class="p-4 text-gray-600">Seminar Hall 2</td>
                                        <td class="p-4"><span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-lg">Upcoming</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-4 font-semibold text-gray-900">MTH-201</td>
                                        <td class="p-4">Advanced Linear Algebra & Statistics</td>
                                        <td class="p-4 text-gray-600">Dec 02, 2026</td>
                                        <td class="p-4 text-gray-600">10:00 AM - 01:00 PM</td>
                                        <td class="p-4 text-gray-600">Main Exam Complex</td>
                                        <td class="p-4"><span class="px-2.5 py-1 bg-gray-100 text-gray-600 text-xs font-bold rounded-lg">Scheduled</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- PROGRAM SCHEDULE TAB -->
                <div id="tab-programs" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">Campus Programs, Workshops & Cultural Events</h3>
                        <p class="text-sm text-gray-500 mb-6">Explore upcoming academic symposia, hackathons, guest lectures, and cultural fests.</p>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="border border-gray-200 rounded-xl p-5 bg-gray-50 flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between items-start mb-3">
                                        <span class="px-2.5 py-1 bg-indigo-100 text-brand-700 text-xs font-bold rounded-lg">Tech Symposium</span>
                                        <span class="text-xs font-semibold text-gray-500"><i class="fa-regular fa-clock mr-1"></i> Dec 10, 2026</span>
                                    </div>
