<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus University - Smart Campus Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-100 font-sans antialiased text-gray-800">

    <!-- LOGIN SCREEN (Visible by default) -->
    <div id="login-screen" class="min-h-screen bg-slate-900 flex items-center justify-center p-6">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8 border border-gray-100">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-50 text-brand-600 text-3xl mb-4 shadow-inner">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">Nexus Smart Campus</h2>
                <p class="text-sm text-gray-500 mt-1">Sign in to access your portal and resources</p>
            </div>
            
            <form onsubmit="handleLogin(event)" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Select Role</label>
                    <select id="login-role" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-brand-500 focus:border-brand-500 bg-gray-50">
                        <option value="Student">Student</option>
                        <option value="Faculty">Faculty Member</option>
                        <option value="Admin">Campus Administrator</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email / Student ID</label>
                    <input type="text" id="login-user" required placeholder="e.g. alex.turner@nexus.edu" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" required placeholder="••••••••" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-brand-500 focus:border-brand-500">
                </div>
                <button type="submit" class="w-full py-3.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl transition-colors shadow-md shadow-brand-500/20">
                    Sign In to Portal
                </button>
            </form>
            <div class="mt-6 text-center text-xs text-gray-400">
                Protected by Nexus Enterprise SSO & IoT Security
            </div>
        </div>
    </div>

    <!-- MAIN APP CONTAINER (Hidden until login) -->
    <div id="main-app" class="hidden flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-300 hidden md:flex flex-col justify-between">
            <div>
                <!-- Logo -->
                <div class="flex items-center space-x-3 px-6 py-5 border-b border-slate-800">
                    <i class="fa-solid fa-graduation-cap text-brand-500 text-2xl"></i>
                    <span class="text-white font-bold text-lg tracking-wide">SmartCampus</span>
                </div>
                <!-- Navigation -->
                <nav class="mt-4 px-4 space-y-1 overflow-y-auto max-h-[calc(100vh-180px)]">
                    <a href="#dashboard" onclick="switchTab('dashboard')" id="nav-dashboard" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg bg-brand-600 text-white font-medium transition-colors">
                        <i class="fa-solid fa-chart-pie w-5"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#exams" onclick="switchTab('exams')" id="nav-exams" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-file-lines w-5"></i>
                        <span>Exam Schedule</span>
                    </a>
                    <a href="#programs" onclick="switchTab('programs')" id="nav-programs" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-calendar-days w-5"></i>
                        <span>Program Schedule</span>
                    </a>
                    <a href="#pyqs" onclick="switchTab('pyqs')" id="nav-pyqs" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-book-bookmark w-5"></i>
                        <span>Previous Year Qs</span>
                    </a>
                    <a href="#college" onclick="switchTab('college')" id="nav-college" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-building-columns w-5"></i>
                        <span>About College & Info</span>
                    </a>
                    <a href="#parking" onclick="switchTab('parking')" id="nav-parking" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-square-parking w-5"></i>
                        <span>Smart Parking</span>
                    </a>
                    <a href="#energy" onclick="switchTab('energy')" id="nav-energy" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-bolt w-5"></i>
                        <span>Energy & IoT</span>
                    </a>
                    <a href="#booking" onclick="switchTab('booking')" id="nav-booking" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-door-open w-5"></i>
                        <span>Facility Booking</span>
                    </a>
                    <a href="#alerts" onclick="switchTab('alerts')" id="nav-alerts" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa-solid fa-triangle-exclamation w-5"></i>
                        <span>Campus Alerts</span>
                    </a>
                </nav>
            </div>
            <!-- User Profile Widget -->
            <div class="p-4 border-t border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <img class="w-9 h-9 rounded-full bg-slate-700 object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=faces" alt="Profile">
                    <div>
                        <h4 id="user-display-name" class="text-sm font-semibold text-white">Alex Turner</h4>
                        <p id="user-display-role" class="text-xs text-slate-400">Student Portal</p>
                    </div>
                </div>
                <button onclick="handleLogout()" title="Sign Out" class="text-slate-400 hover:text-red-400 transition-colors">
                    <i class="fa-solid fa-right-from-bracket text-base"></i>
                </button>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="flex-1 flex flex-col overflow-y-auto">
            
            <!-- Top Navbar -->
            <header class="bg-white shadow-sm h-16 flex items-center justify-between px-8 z-10">
