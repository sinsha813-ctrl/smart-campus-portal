                                        <span class="text-xs font-semibold text-gray-500"><i class="fa-regular fa-clock mr-1"></i> Dec 14, 2026</span>
                                    </div>
                                    <h4 class="font-bold text-gray-900 text-base">Future of Green Energy Grids & Smart Cities</h4>
                                    <p class="text-xs text-gray-600 mt-2">Keynote address by Dr. Elena Vance on modern campus energy efficiency and decentralized renewables.</p>
                                </div>
                                <div class="mt-5 pt-4 border-t border-gray-200 flex items-center justify-between">
                                    <span class="text-xs font-medium text-gray-500"><i class="fa-solid fa-location-dot mr-1"></i> Central Auditorium A</span>
                                    <button onclick="alert('Successfully reserved seat!')" class="px-3.5 py-1.5 bg-brand-600 text-white text-xs font-semibold rounded-lg hover:bg-brand-700">RSVP</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PREVIOUS YEAR QUESTIONS (PYQS) TAB -->
                <div id="tab-pyqs" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
