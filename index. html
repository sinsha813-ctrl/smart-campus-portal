                            <div class="p-4 bg-indigo-50 text-brand-600 rounded-xl text-2xl"><i class="fa-solid fa-users"></i></div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Active Campus Population</p>
                                <h3 class="text-2xl font-bold text-gray-900 mt-1">14,280</h3>
                                <span class="text-xs text-green-600 font-semibold"><i class="fa-solid fa-arrow-up"></i> +4.2% today</span>
                            </div>
                        </div>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4">
